# Docker Compose binds Qdrant on localhost. Keep the URL in sync if the port changes.
SCIFACT_QDRANT_PORT=6333
SCIFACT_QDRANT_URL=http://127.0.0.1:6333
SCIFACT_QDRANT_COLLECTION=scifact
SCIFACT_QDRANT_TIMEOUT=60
# SCIFACT_QDRANT_API_KEY=

SCIFACT_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Default models use pinned revisions. Set a commit SHA when using another Hub model.
# SCIFACT_DENSE_REVISION=
SCIFACT_DENSE_DEVICE=cpu
SCIFACT_EMBEDDING_BATCH_SIZE=32
SCIFACT_INDEX_BATCH_SIZE=64

SCIFACT_SEARCH__STRATEGY=hybrid
SCIFACT_SEARCH__TOP_K=5
SCIFACT_SEARCH__HYBRID_DEPTH=50
SCIFACT_SEARCH__EXACT_DENSE_SEARCH=true
# Raw score cutoffs for cosine, BM25, and RRF, respectively.
# SCIFACT_SEARCH__DENSE_MIN_SCORE=0.25
# SCIFACT_SEARCH__SPARSE_MIN_SCORE=1.0
# SCIFACT_SEARCH__HYBRID_MIN_SCORE=0.2

SCIFACT_SEARCH__RERANK=false
SCIFACT_SEARCH__RERANK_CANDIDATES=10
SCIFACT_RERANK_MODEL=cross-encoder/ms-marco-TinyBERT-L2-v2
# SCIFACT_RERANK_REVISION=
SCIFACT_RERANK_DEVICE=cpu
SCIFACT_RERANK_MAX_LENGTH=256
SCIFACT_RERANK_BATCH_SIZE=16

SCIFACT_TORCH_THREADS=4
SCIFACT_LOG_LEVEL=INFO
