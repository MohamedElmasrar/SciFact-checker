# Set GOOGLE_API_KEY or GEMINI_API_KEY.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45

RESEARCH_MCP_TRANSPORT=http
RESEARCH_MCP_URL=http://127.0.0.1:8000/mcp
# For stdio, optionally override the default sibling directory:
# RESEARCH_MCP_DIRECTORY=/path/to/research-mcp-server
RESEARCH_MCP_DISCOVERY_SECONDS=5
RESEARCH_MCP_TIMEOUT_SECONDS=75

SCIFACT_QDRANT_URL=http://127.0.0.1:6333
SCIFACT_QDRANT_COLLECTION=scifact
SCIFACT_QDRANT_TIMEOUT=30
SCIFACT_TIMEOUT_SECONDS=45
# SCIFACT_QDRANT_API_KEY=
SCIFACT_SEARCH__STRATEGY=hybrid
SCIFACT_SEARCH__RERANK=false

# Optional LangSmith tracing.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=scientific-fact-checker
