# Provider credentials (optional)
RESEARCH_OPENALEX_API_KEY=
RESEARCH_OPENALEX_EMAIL=
RESEARCH_SEMANTICSCHOLAR_API_KEY=

# Per-request timeouts and minimum spacing between provider requests, in seconds
RESEARCH_OPENALEX_TIMEOUT=15
RESEARCH_ARXIV_TIMEOUT=20
RESEARCH_SEMANTICSCHOLAR_TIMEOUT=20
RESEARCH_PDF_TIMEOUT=30
RESEARCH_PDF_TOTAL_TIMEOUT=60
RESEARCH_OPENALEX_INTERVAL=0.2
RESEARCH_ARXIV_INTERVAL=3
RESEARCH_SEMANTICSCHOLAR_INTERVAL=1

# Total attempts, including the first call, and maximum retry delay in seconds
RESEARCH_RETRY_ATTEMPTS=3
RESEARCH_RETRY_MAX_DELAY=30

# In-memory cache sizes and lifetimes in seconds. Set a size to 0 to disable that cache.
RESEARCH_METADATA_CACHE_SIZE=512
RESEARCH_SEARCH_CACHE_SIZE=128
RESEARCH_DOCUMENT_CACHE_BYTES=33554432
RESEARCH_METADATA_CACHE_TTL=3600
RESEARCH_SEARCH_CACHE_TTL=900
RESEARCH_DOCUMENT_CACHE_TTL=3600

# PDF download, extraction, and response limits
RESEARCH_PDF_MAX_BYTES=26214400
RESEARCH_PDF_MAX_PAGES=40
RESEARCH_CONTENT_DEFAULT_CHARS=20000
RESEARCH_CONTENT_MAX_CHARS=100000

RESEARCH_LOG_LEVEL=INFO
